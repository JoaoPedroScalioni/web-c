# ==========================================
# ENV: PRODUÇÃO (Go-to-Market)
# Renomeie este arquivo para .env.production
# e preencha com credenciais reais do servidor.
# ==========================================

# --- APRESENTAÇÃO: Tirar print daqui até a linha 24 ---
# Explicação: Exemplo de configuração exigida para Produção. Ele demonstra 
# boas práticas ao ter credenciais de banco (POSTGRES_DB) separadas e chaves JWT rigorosas, evitando "Hardcode" no código-fonte.
# Segurança do FastAPI
JWT_SECRET_KEY=gerar_uma_chave_segura_de_64_chars_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
TIMEZONE=America/Sao_Paulo

# Banco de Dados (Host interno ao Docker = db)
POSTGRES_USER=elevva_prod_admin
POSTGRES_PASSWORD=senha_super_segura_em_producao
POSTGRES_DB=elevva_prod
DATABASE_URL=postgresql+asyncpg://elevva_prod_admin:senha_super_segura_em_producao@db:5432/elevva_prod

# Storage Backend: "local", "minio", ou "r2" (Cloudflare R2)
STORAGE_BACKEND=r2

# Cloudflare R2 (Storage em Nuvem)
# Crie um bucket R2 em https://dash.cloudflare.com/ -> R2
# Gere um token de API com permissão de leitura/escrita de objetos
R2_ACCOUNT_ID=seu_account_id_aqui
R2_ACCESS_KEY_ID=sua_access_key_aqui
R2_SECRET_ACCESS_KEY=sua_secret_key_aqui
R2_BUCKET_NAME=elevva-midias
R2_PUBLIC_URL=https://pub-exemplo.r2.dev

# AWS S3 Bypass Credentials (IAM User apenas com permissão de s3:PutObject)
AWS_ACCESS_KEY_ID=AKIA_SUA_CHAVE_AQUI
AWS_SECRET_ACCESS_KEY=SUA_SECRET_AQUI
AWS_REGION=us-east-1
S3_BUCKET_NAME=elevva-uploads-prod

# Logging (INFO, WARNING, ERROR)
LOG_LEVEL=WARNING

# CORS - origens permitidas separadas por vírgula
CORS_ORIGINS=https://app.elevva.com,https://www.elevva.com

# URLs Publicas
# Importante: Como temos um Reverse Proxy (Nginx), o frontend chama o próprio domínio em /api
NEXT_PUBLIC_API_URL=https://app.elevva.com/api
