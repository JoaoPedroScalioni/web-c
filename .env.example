TIMEZONE=America/Sao_Paulo

# Credenciais do Banco
POSTGRES_USER=elevva_su
POSTGRES_PASSWORD=elevva_secure_password
POSTGRES_DB=elevva_db
DATABASE_URL=postgresql+asyncpg://elevva_su:elevva_secure_password@db:5432/elevva_db
TEST_DATABASE_URL=postgresql+asyncpg://elevva_su:elevva_secure_password@db:5432/elevva_test

# Governança de Autenticação
JWT_SECRET_KEY=inserir_chave_jwt_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudflare R2 (Storage em Nuvem - S3-compatível)
# Descomente e preencha para usar R2:
# STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=seu_account_id_aqui
# R2_ACCESS_KEY_ID=sua_access_key_aqui
# R2_SECRET_ACCESS_KEY=sua_secret_key_aqui
# R2_BUCKET_NAME=elevva-midias
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Infraestrutura Cloud (Uploads 500MB)
AWS_ACCESS_KEY_ID=aws_access
AWS_SECRET_ACCESS_KEY=aws_secret
AWS_REGION=us-east-1
S3_BUCKET_NAME=elevva-marketing-bucket

# MinIO Local
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_NAME=elevva-midias
