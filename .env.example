# Credenciais do Banco
POSTGRES_USER=elevva_su
POSTGRES_PASSWORD=elevva_secure_password
POSTGRES_DB=elevva_db
DATABASE_URL=postgresql+asyncpg://elevva_su:elevva_secure_password@db:5432/elevva_db

# Governança de Autenticação
